    <script>
        // Interactive UK Materials & Fitting Estimator Logic
        const calcSystem = document.getElementById('calcSystem');
        const calcMeters = document.getElementById('calcMeters');
        const resPipes = document.getElementById('resPipes');
        const resCouplers = document.getElementById('resCouplers');
        const resLube = document.getElementById('resLube');

        function updateEstimate() {
            const meters = parseFloat(calcMeters.value) || 0;
            const system = calcSystem.value;

            if (system === 'pushfit110') {
                const pipes = Math.ceil(meters / 3);
                const couplers = Math.ceil(meters / 2.5);
                const clips = Math.ceil(meters * 1.2);
                resPipes.textContent = `${pipes} lengths x 3m (110mm Pushfit Soil Pipe - Black/Grey)`;
                resCouplers.textContent = `${couplers} Double Socket Couplers / ${clips} Pipe Clips`;
                resLube.textContent = '1x 500ml Silicone Lubricant Spray';
            } else if (system === 'solvent110') {
                const pipes = Math.ceil(meters / 3);
                const couplers = Math.ceil(meters / 2.5);
                const clips = Math.ceil(meters * 1.2);
                resPipes.textContent = `${pipes} lengths x 3m (110mm Solvent Weld Soil Pipe)`;
                resCouplers.textContent = `${couplers} Solvent Couplers / ${clips} Pipe Clips`;
                resLube.textContent = '1x 500ml PVC Solvent Cement + Cleaner';
            } else if (system === 'waste32') {
                const pipes = Math.ceil(meters / 3);
                const couplers = Math.ceil(meters / 1.5);
                const clips = Math.ceil(meters * 1.5);
                resPipes.textContent = `${pipes} lengths x 3m (32mm Solvent Weld Waste Pipe)`;
                resCouplers.textContent = `${couplers} Straight Couplings / ${clips} Pipe Clips`;
                resLube.textContent = '1x 250ml Solvent Cement Tin';
            } else if (system === 'underground110') {
                const pipes = Math.ceil(meters / 3);
                const chambers = Math.ceil(meters / 15);
                resPipes.textContent = `${pipes} lengths x 3m (110mm Terracotta Underground Pipe EN1401)`;
                resCouplers.textContent = `${pipes} Socket Couplers / ${chambers} Inspection Chamber(s)`;
                resLube.textContent = '2x 500ml Silicone Lubricant Tubs';
            } else if (system === 'mdpe25') {
                const coils = meters <= 25 ? '1x 25m Coil' : meters <= 50 ? '1x 50m Coil' : `${Math.ceil(meters / 100)}x 100m Coils`;
                const fittings = Math.ceil(meters / 10);
                resPipes.textContent = `${coils} (25mm Blue MDPE Water Pipe)`;
                resCouplers.textContent = `${fittings} WRAS Compression Couplings`;
                resLube.textContent = '1x MDPE Pipe Cutter & PTFE Tape Pack';
            }
        }

        calcSystem.addEventListener('change', updateEstimate);
        calcMeters.addEventListener('input', updateEstimate);

        // FAQ Accordion Toggle
        document.querySelectorAll('.faq-toggle').forEach(button => {
            button.addEventListener('click', () => {
                const content = button.nextElementSibling;
                const icon = button.querySelector('i');
                
                content.classList.toggle('hidden');
                icon.classList.toggle('rotate-180');
            });
        });
    </script>
